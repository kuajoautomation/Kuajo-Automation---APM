---
import SectionHead from './SectionHead.astro';
import Figura from './Figura.astro';
import { profiles, recipes, recipeParams, procedureTree, pccNote, physicalModel, recipeLevels } from '../data/site';

const P = { w: 400, h: 220, x0: 38, x1: 388, y0: 182, y1: 18, tMax: 36, cMax: 100 };
const X = (h: number) => P.x0 + (h / P.tMax) * (P.x1 - P.x0);
const Y = (c: number) => P.y0 - (c / P.cMax) * (P.y0 - P.y1);
const path = (pts: [number, number][]) => pts.map(([h, c], i) => `${i ? 'L' : 'M'} ${X(h).toFixed(1)} ${Y(c).toFixed(1)}`).join(' ');
const fmt = (n: number) => n.toLocaleString('es-CO', { maximumFractionDigits: 1 });
// Meseta de incubación = tramo más largo a temperatura constante
const plateau = (pts: [number, number][]) => {
  let best = { a: 0, b: 0, c: 0 };
  for (let i = 1; i < pts.length; i++) {
    const [ha, ca] = pts[i - 1], [hb, cb] = pts[i];
    if (ca === cb && hb - ha > best.b - best.a) best = { a: ha, b: hb, c: ca };
  }
  return best;
};
---
<section class="sec" id="recetas" aria-labelledby="recetas-t">
  <div class="wrap">
    <SectionHead id="recetas" title="Kéfir a 24 °C por 20 h. Griego a 43 °C por 6 h. Mismo PLC." note="ISA-88 · Tablas 7.5 y 10.3" />

    <div class="multiples">
      {recipes.map((r) => {
        const pts = profiles[r.id];
        const p = plateau(pts);
        const end = pts[pts.length - 1][0];
        return (
          <figure class={`fig mult c-${r.id.toLowerCase()}`}>
            <figcaption class="mult__head">
              <span class="mono mult__id"><span class="dot" aria-hidden="true" />{r.id}</span>
              <span class="mult__name">{r.name}</span>
              <span class="micro">≈ {fmt(end)} h hasta el llenado</span>
            </figcaption>
            <svg viewBox={`0 0 ${P.w} ${P.h}`} role="img" aria-label={`Perfil de temperatura de ${r.id} ${r.name}: incubación a ${p.c} °C durante ${fmt(p.b - p.a)} h; ${fmt(end)} h hasta el llenado.`}>
              {[0, 50, 100].map((c) => (
                <g>
                  <path d={`M ${P.x0} ${Y(c)} H ${P.x1}`} class="mult__grid" />
                  <text class="svg-mono" x={P.x0 - 8} y={Y(c) + 4} font-size="11" text-anchor="end">{c}</text>
                </g>
              ))}
              {[0, 12, 24, 36].map((h) => (
                <text class="svg-mono" x={X(h)} y={P.y0 + 22} font-size="11" text-anchor={h === 0 ? 'start' : 'middle'}>{h} h</text>
              ))}
              <path d={`M ${X(p.a)} ${Y(p.c)} H ${X(p.b)}`} class="mult__plateau" />
              <path d={path(pts)} class="mult__line" data-draw />
              <text class="svg-mono mult__ann" x={Math.min(X(p.a) + 2, P.x1 - 110)} y={Y(p.c) - 10} font-size="12">{p.c} °C · {fmt(p.b - p.a)} h</text>
            </svg>
          </figure>
        );
      })}
    </div>
    <p class="micro mult__axis">Perfil de temperatura simplificado (°C contra horas, misma escala). El kéfir ocupa su fermentador tres veces más que el yogur de fresa: 23,5 h frente a 8 h por lote.</p>

    <div class="block">
      <div class="tbl-wrap" style="--tbl-min: 620px" tabindex="0" role="region" aria-label="Parámetros de la receta maestra">
        <table class="table rec__table">
          <caption class="micro">Tabla 7.5 · receta maestra: parámetros que el MES descarga al PLC al iniciar cada lote</caption>
          <thead><tr><th scope="col">Parámetro</th>{recipes.map((r) => <th scope="col" class={`c-${r.id.toLowerCase()}`}><span class="dot" aria-hidden="true" />{r.id} {r.name}</th>)}</tr></thead>
          <tbody>{recipeParams.map(([k, ...v]) => <tr><th scope="row">{k}</th>{v.map((x) => <td class="mono rec__v">{x}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <blockquote class="rec__quote"><p>Una sola fase <span class="mono">Incubar</span> sirve para 43 °C durante 4,5 h o para 24 °C durante 20 h. Cambia el dato, no el programa.</p></blockquote>
    </div>

    <div class="block cols cols--57">
      <div>
        <header class="block__head"><h3 class="block__t">Modelo procedimental.</h3>
          <p class="block__lead">Un procedimiento único para las 3 recetas. Despliega cada nivel: procedimiento → procedimiento de unidad → operaciones → fases. Las fases con la receta entre paréntesis solo se habilitan en esa receta.</p></header>
        <details class="fold tree" open>
          <summary><span><span class="micro">Procedimiento</span> Elaborar yogur (Y1, Y2 o Y3)</span></summary>
          <div class="fold__body">
            {procedureTree.map((p) => (
              <details class="fold tree__pu">
                <summary><span><span class="micro">Proc. de unidad</span> {p.pu}</span><span class="mono tree__u">{p.unidad}</span></summary>
                <div class="fold__body">
                  <dl class="kv">
                    <div><dt>Operaciones</dt><dd>{p.ops}</dd></div>
                    <div><dt>Fases</dt><dd>{p.fases}</dd></div>
                  </dl>
                </div>
              </details>
            ))}
          </div>
        </details>
        <p class="pcc"><strong class="micro">PCC 1 · vigilancia, no fase</strong>{pccNote}</p>
        <p class="note">Cada fase sigue el modelo de estados de ISA-88 (Idle, Running, Held, Complete, Stopped, Aborted) y las transiciones las dan condiciones de proceso, por ejemplo «pH ≤ pH de receta» para pasar de Esperar pH a Agitar.</p>
      </div>
      <div>
        <header class="block__head"><h3 class="block__t">Modelo físico y niveles de receta.</h3></header>
        <dl class="kv">{physicalModel.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
        <h4 class="micro" style="margin-top: var(--s-6)">4 niveles de receta ISA-88</h4>
        <dl class="kv" style="margin-top: var(--s-3)">{recipeLevels.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
        <p class="note">Lote de la línea 1 = un fermentador desde la inoculación hasta su vaciado: 10.000 kg, con 2,6 (Y1), 3,3 (Y2) y 1,3 (Y3) lotes por día.</p>
      </div>
    </div>

    <div class="block cols cols--2">
      <Figura id="f101" sizes="(min-width: 1080px) 660px, 100vw" />
      <Figura id="f102" sizes="(min-width: 1080px) 660px, 100vw" />
    </div>
  </div>
</section>

<style>
  .multiples { display: grid; gap: var(--s-6) var(--gap); }
  @media (min-width: 720px) { .multiples { grid-template-columns: repeat(3, 1fr); } }
  .mult__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-1) var(--s-3); padding-top: var(--s-3); border-top: 1px solid var(--ink); margin-bottom: var(--s-3); }
  .mult__id { font-weight: 500; }
  .mult__name { font: 650 var(--t-3)/1 var(--f-display); letter-spacing: -0.03em; margin-right: auto; }
  .mult__grid { stroke: var(--rule); stroke-width: 1; fill: none; }
  .mult__line { fill: none; stroke: var(--c); stroke-width: 2.5; stroke-linejoin: round; }
  .mult__plateau { stroke: var(--c); stroke-width: 10; opacity: 0.14; fill: none; }
  .mult__ann { fill: var(--ink); font-weight: 500; }
  .mult__axis { margin-top: var(--s-4); text-transform: none; letter-spacing: 0.01em; max-width: 80ch; }
  .rec__v { font-size: 0.8125rem; }
  .rec__quote { margin: var(--s-6) 0 0; font: 600 var(--t-3)/1.25 var(--f-display); letter-spacing: -0.02em; max-width: 36ch; }
  .tree > summary { font: 650 var(--t-3)/1.2 var(--f-display); letter-spacing: -0.02em; }
  .tree summary .micro { display: block; margin-bottom: 2px; font-family: var(--f-mono); }
  .tree__pu { margin-left: var(--s-4); border-left: 1px solid var(--rule-2); padding-left: var(--s-4); }
  .tree__pu > summary { font-weight: 600; }
  .tree__u { font-size: var(--t-micro); color: var(--ink-3); font-weight: 500; text-align: right; }
  .pcc { margin-top: var(--s-5); padding: var(--s-4); border-left: 3px solid var(--st-warn); background: var(--paper-2); font-size: var(--t-small); }
  .pcc strong { display: block; margin-bottom: var(--s-2); color: var(--st-warn-ink); }
</style>
