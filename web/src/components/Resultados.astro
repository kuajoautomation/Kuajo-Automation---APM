---
import SectionHead from './SectionHead.astro';
import { modules } from '../data/site';
---
<section class="sec" id="resultados" aria-labelledby="resultados-t">
  <div class="wrap">
    <SectionHead id="resultados" title="Gestión y PM4R, hechos. Celda, gemelo y PLC, para la entrega final." note="Entrega intermedia · 12 oct. 2026" />

    <ol class="mods">
      {modules.map((m) => (
        <li>
          <details class="mod">
            <summary class="mod__row">
              <span class="mono mod__n">{m.n}</span>
              <span class="mod__t">{m.t}</span>
              <span class="mod__tools">{m.tools.map((t) => <span class="tag">{t}</span>)}</span>
              <span class="mono mod__fig">{m.fig}</span>
              <span class:list={['micro mod__st', { 'is-pending': m.status === 'Pendiente' }]}>{m.status}</span>
              <span class="mod__plus" aria-hidden="true"></span>
            </summary>
            <div class="mod__body">
              <p>{m.d}</p>
              <p class="micro">Responsable · {m.owner}</p>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .mods { border-top: 1px solid var(--ink); }
  .mod { border-bottom: 1px solid var(--rule); }
  .mod__row {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 3rem 1fr 1.5rem; align-items: baseline; gap: var(--s-2) var(--s-4);
    padding-block: var(--s-5);
    transition: padding var(--d-2) var(--ease);
    &::-webkit-details-marker { display: none; }
    &:hover { padding-left: var(--s-3); }
    &:hover .mod__t { color: var(--accent); }
    @media (min-width: 1080px) {
      grid-template-columns: 4rem minmax(0, 5fr) minmax(0, 3fr) minmax(0, 2fr) 6rem 1.5rem;
      padding-block: var(--s-6);
    }
  }
  .mod__n { color: var(--ink-3); }
  .mod__t { font: 650 var(--t-3)/1.1 var(--f-display); letter-spacing: -0.03em; transition: color var(--d-1) var(--ease); }
  .mod__tools, .mod__fig, .mod__st { grid-column: 2 / 3; }
  .mod__tools { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); }
  .mod__fig { font-size: var(--t-lead); font-weight: 500; letter-spacing: -0.03em; }
  .mod__st { color: var(--accent); }
  .mod__st.is-pending { color: var(--st-warn-ink); }
  .mod__plus {
    grid-column: 3; grid-row: 1; justify-self: end; width: 14px; height: 14px; position: relative;
    &::before, &::after { content: ''; position: absolute; inset: 6px 0 auto; height: 1.5px; background: var(--ink); transition: transform var(--d-2) var(--ease); }
    &::after { transform: rotate(90deg); }
  }
  .mod[open] .mod__plus::after { transform: rotate(0deg); }
  @media (min-width: 1080px) {
    .mod__tools, .mod__fig, .mod__st { grid-column: auto; }
    .mod__plus { grid-column: auto; grid-row: auto; }
  }
  .mod__body {
    display: grid; gap: var(--s-3);
    padding: 0 0 var(--s-6) calc(3rem + var(--s-4));
    max-width: 70ch; color: var(--ink-2);
    @media (min-width: 1080px) { padding-left: calc(4rem + var(--s-4)); }
  }
  .mod::details-content { transition: content-visibility var(--d-3) allow-discrete, block-size var(--d-3) var(--ease); block-size: 0; overflow: clip; }
  .mod[open]::details-content { block-size: auto; }
  @supports (interpolate-size: allow-keywords) { :root { interpolate-size: allow-keywords; } }
</style>
