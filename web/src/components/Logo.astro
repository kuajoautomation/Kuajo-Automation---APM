---
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
---
<svg class:list={['logo-mark', cls]} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <rect x="2" y="2" width="60" height="60" rx="15" fill="var(--logo-bg, var(--accent))" />
  <path d="M21 16v32M21 32l19-14M21 32l19 14" fill="none" stroke="var(--logo-fg, var(--paper))" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="44" cy="15" r="5.5" fill="var(--logo-node, var(--lime))" />
  <circle cx="44" cy="49" r="5.5" fill="var(--logo-fg, var(--paper))" />
</svg>
